{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "*-firebase-adminsdk-*.json"
    ],
    "rewrites": [
      { "source": "/laser/chrono", "destination": "/laser/chrono.html" }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
